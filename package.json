{
  "name": "gimatria",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"node server/index.js\"",
    "dev:frontend": "vite",
    "dev:backend": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/auth-startup.test.js tests/derived-letter-matching.test.js tests/gematria.test.js tests/hebrewKeyboard.test.js tests/milui-canonical.test.js tests/multiples.test.js tests/tanach.test.js tests/tanach-gematria-search.test.js tests/tanach-startup.test.js tests/tefillot-availability.test.js tests/tefillot-corpus.test.js tests/tefillot-discovery.test.js tests/uxlc-text.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api.test.js tests/base-words.test.js tests/auth-session-routing.test.js tests/database-initialization.test.js",
    "test:browser": "node scripts/run-e2e.js tests/calculator-keyboard.spec.js tests/tanach-browser.spec.js",
    "test:e2e": "node scripts/run-e2e.js",
    "test:tefillot:e2e": "E2E_TEFILLOT_ENABLED=true node scripts/run-e2e.js tests/tefillot-enabled.spec.js",
    "import:tanach": "node scripts/import-tanach.js",
    "import:tefillot": "node scripts/import-tefillot.js"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
    "@lucide/vue": "^1.41.0",
    "@mdi/font": "7.4.47",
    "concurrently": "^9.2.4",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fflate": "^0.8.3",
    "pg": "^8.23.0",
    "roboto-fontface": "*",
    "supertest": "^7.2.2",
    "vue": "^3.4.31",
    "vuetify": "^3.6.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "sass": "1.77.8",
    "sass-embedded": "^1.77.8",
    "unplugin-fonts": "^1.1.1",
    "unplugin-vue-components": "^0.27.2",
    "vite": "^5.4.0",
    "vite-plugin-vuetify": "^2.0.3"
  }
}
