modules = ["vue-node-20", "nodejs-20", "web", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "browser"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:e2e"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 4173
externalPort = 3001

[[ports]]
localPort = 4174
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 4200

[[ports]]
localPort = 23636
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_ENV=production node server/index.js"]
build = ["npm", "run", "build"]

[userenv]

[userenv.production]
TEFILLOT_ENABLED = "true"
